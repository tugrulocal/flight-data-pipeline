# OpenSky veri alanı.
# turkey: Türkiye ve yakın çevresi
# global: tüm dünya
OPENSKY_AREA_MODE=turkey

# OpenSky OAuth2 client credentials.
# Gerçek değerleri .env dosyasına yaz; .env git tarafından izlenmez.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Producer çağrı ayarları.
POLL_INTERVAL_SECONDS=30
MAX_POLLS=0
PRODUCER_RESTART_POLICY=unless-stopped

# Release image ve local frontend portu.
APP_VERSION=1.0.0-rc.1
APP_PORT=5173

# Boş bırakılırsa backend localhost ve 127.0.0.1 adreslerini
# APP_PORT değerinden otomatik üretir. Yalnız özel origin gerekiyorsa doldur.
CORS_ORIGINS=

# MongoDB saklama süreleri: raw geçmişi 48 saat, live son durumu 7 gün.
RAW_POSITIONS_RETENTION_HOURS=48
LIVE_POSITIONS_RETENTION_HOURS=168

# Kafka raw: 48 saat + 10 GiB acil sınır. DLQ: 30 gün + 1 GiB.
KAFKA_RAW_RETENTION_MS=172800000
KAFKA_RAW_RETENTION_BYTES=10737418240
KAFKA_DLQ_RETENTION_MS=2592000000
KAFKA_DLQ_RETENTION_BYTES=1073741824

# MongoDB writer retry ve DLQ davranışı.
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_BACKOFF_SECONDS=1

# FastAPI WebSocket batch ayarları.
# Global modda binlerce tekil mesaj yerine kısa aralıklarla toplu mesaj gönderir.
WEBSOCKET_BATCH_INTERVAL_MS=250
WEBSOCKET_BATCH_MAX_SIZE=500

# Frontend'in canlı haritada göstereceği son görülme penceresi.
# Global tek poll testinde verinin 10 dakika sonra kaybolmuş gibi görünmesini önler.
LIVE_POSITION_WINDOW_MINUTES=10
