  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "MongoDB'ye son yazılan uçuş verisinin yaşı. 3 dakikadan sonrası dikkat, 5 dakikadan sonrası sorun kabul edilir.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 8 },
      "id": 2,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max(flight_backend_data_freshness_seconds{namespace=\"flight-data-pipeline\"})",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Uçuş verisi yaşı",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend HTTP endpoint'lerine gelen istek hızı; route ve HTTP durum koduna göre gruplanır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (route, status_code) (rate(flight_backend_http_requests_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{route}} · {{status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP istek hızı (5 dk ortalama)",
      "transparent": true,
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend HTTP isteklerinin p95 yanıt süresi. İsteklerin %95'i bu değerin altında tamamlanır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "id": 5,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flight_backend_http_request_duration_seconds_bucket{namespace=\"flight-data-pipeline\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP p95 yanıt süresi",
      "transparent": true,
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend'in Kafka'dan işlediği mesaj hızı. Pod yeniden başlarsa sayaç sıfırlanır; rate bunu doğru yorumlar.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "id": 6,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(flight_backend_kafka_processed_messages{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "mesaj/sn",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kafka işleme hızı",
      "transparent": true,
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Uzun ömürlü uygulama pod'larının Kubernetes Ready koşulu. Tek seferlik kafka-topic-init Job'u Completed olduğu için burada gösterilmez.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 1,
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "Hazır değil" },
                "1": { "color": "green", "index": 1, "text": "Hazır" }
              },
              "type": "value"
            }
          ],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^kafka-[0-9]+$/" },
            "properties": [ { "id": "displayName", "value": "Kafka" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^mongodb-[0-9]+$/" },
            "properties": [ { "id": "displayName", "value": "MongoDB" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^backend-.*$/" },
            "properties": [ { "id": "displayName", "value": "Backend" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^frontend-.*$/" },
            "properties": [ { "id": "displayName", "value": "Frontend" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^producer-.*$/" },
            "properties": [ { "id": "displayName", "value": "Producer" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^consumer-.*$/" },
            "properties": [ { "id": "displayName", "value": "Consumer" } ]
          }
        ]
      },
      "gridPos": { "h": 13, "w": 8, "x": 0, "y": 0 },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "showUnfilled": true
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "kube_pod_status_ready{namespace=\"flight-data-pipeline\", condition=\"true\", pod!~\"kafka-topic-init-.*\"}",
          "instant": true,
          "legendFormat": "{{pod}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pod hazır olma durumu",
      "transparent": true,
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Her pod'un son 5 dakikadaki ortalama CPU çekirdeği kullanımı.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "cores" },
        "overrides": []
      },
      "gridPos": { "h": 13, "w": 8, "x": 16, "y": 0 },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"flight-data-pipeline\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod CPU kullanımı",
      "transparent": true,
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Her pod'un çalışan bellek kümesi (working set). Bu değer pod'un bellek basıncını görmek için kullanılır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "id": 9,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"flight-data-pipeline\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod bellek kullanımı",
      "transparent": true,
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pod'ların gerçek ağ alım (RX) ve gönderim (TX) hızı. HTTP isteğinden farklı olarak Kafka ve MongoDB dahil tüm pod trafiğini kapsar.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps" },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 31 },
      "id": 10,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{pod}} RX",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{pod}} TX",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Pod ağ trafiği (RX / TX)",
      "transparent": true,
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Docker Desktop Kubernetes node'unun CPU ve RAM kullanım yüzdesi. Bu değer pod değil, pod'ları çalıştıran node içindir.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 11,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "showUnfilled": true
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU · {{instance}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "RAM · {{instance}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Node CPU / RAM kullanımı",
      "transparent": true,
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Son bir saat içinde aynı pod içindeki container yeniden başlatmalarının sayısı. Deployment rollout'u yeni pod oluşturduğu için bu metrik doğrudan uygulama çökmesi veya liveness/OOM sorunlarını yakalamada kullanılır.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 31 },
      "id": 12,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"flight-data-pipeline\", container!=\"topic-init\"}[1h]))",
          "instant": true,
          "legendFormat": "{{pod}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Son 1 saatte container restart",
      "transparent": true,
      "type": "bargauge"
    }
  ],
