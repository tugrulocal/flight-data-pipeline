{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus scrape, backend -> MongoDB ping ve backend Kafka realtime bağlantısını tek bakışta gösterir.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "displayMode": "basic",
        "minVizHeight": 10,
        "minVizWidth": 75,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "label_replace(min by (namespace) (up{namespace=\"flight-data-pipeline\", service=\"backend\"}), \"component\", \"Backend scrape\", \"namespace\", \".*\") or label_replace(min by (namespace) (flight_backend_mongodb_up{namespace=\"flight-data-pipeline\"}), \"component\", \"MongoDB\", \"namespace\", \".*\") or label_replace(min by (namespace) (flight_backend_kafka_realtime_connected{namespace=\"flight-data-pipeline\"}), \"component\", \"Kafka realtime\", \"namespace\", \".*\")",
          "instant": true,
          "legendFormat": "{{component}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Bileşen sağlığı",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "MongoDB'ye son yazılan uçuş verisinin yaşı. 3 dakikadan sonrası dikkat, 5 dakikadan sonrası sorun kabul edilir.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max(flight_backend_data_freshness_seconds{namespace=\"flight-data-pipeline\"})",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Uçuş verisi yaşı",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend'e bağlı canlı harita/WebSocket istemcilerinin toplamı.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(flight_backend_websocket_clients{namespace=\"flight-data-pipeline\"})",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Canlı istemci",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend HTTP endpoint'lerine gelen istek hızı; route ve HTTP durum koduna göre gruplanır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (route, status_code) (rate(flight_backend_http_requests_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{route}} · {{status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP istek hızı (5 dk ortalama)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend HTTP isteklerinin p95 yanıt süresi. İsteklerin %95'i bu değerin altında tamamlanır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flight_backend_http_request_duration_seconds_bucket{namespace=\"flight-data-pipeline\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP p95 yanıt süresi",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backend'in Kafka'dan işlediği mesaj hızı. Pod yeniden başlarsa sayaç sıfırlanır; rate bunu doğru yorumlar.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "id": 6,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(flight_backend_kafka_processed_messages{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "mesaj/sn",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kafka işleme hızı",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Uzun ömürlü uygulama pod'larının Kubernetes Ready koşulu. Tek seferlik kafka-topic-init Job'u Completed olduğu için burada gösterilmez.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "id": 7,
      "options": {
        "displayMode": "basic",
        "minVizHeight": 10,
        "minVizWidth": 75,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "kube_pod_status_ready{namespace=\"flight-data-pipeline\", condition=\"true\", pod!~\"kafka-topic-init-.*\"}",
          "instant": true,
          "legendFormat": "{{pod}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pod hazır olma durumu",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Her pod'un son 5 dakikadaki ortalama CPU çekirdeği kullanımı.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "cores" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "id": 8,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"flight-data-pipeline\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod CPU kullanımı",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Her pod'un çalışan bellek kümesi (working set). Bu değer pod'un bellek basıncını görmek için kullanılır.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "id": 9,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"flight-data-pipeline\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod bellek kullanımı",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pod'ların gerçek ağ alım (RX) ve gönderim (TX) hızı. HTTP isteğinden farklı olarak Kafka ve MongoDB dahil tüm pod trafiğini kapsar.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "id": 10,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{pod}} RX",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"flight-data-pipeline\"}[5m]))",
          "legendFormat": "{{pod}} TX",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Pod ağ trafiği (RX / TX)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Docker Desktop Kubernetes node'unun CPU ve RAM kullanım yüzdesi. Bu değer pod değil, pod'ları çalıştıran node içindir.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 44 },
      "id": 11,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "13.1.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU · {{instance}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "RAM · {{instance}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Node CPU / RAM kullanımı",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
